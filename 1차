    function bindAuth() {
      const tabs = document.querySelectorAll('#authTabs button');
      const loginForm = document.getElementById('loginForm');
      const signupForm = document.getElementById('signupForm');
      const authError = document.getElementById('authError');
      tabs.forEach(btn => {
        btn.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          btn.classList.add('active');
          const tab = btn.dataset.tab;
          loginForm.classList.toggle('hidden', tab !== 'login');
          signupForm.classList.toggle('hidden', tab !== 'signup');
          authError.classList.add('hidden');
        });
      });
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const users = load(USERS_KEY, defaultUsers);
        const email = document.getElementById('loginEmail').value.trim();
        const password = document.getElementById('loginPassword').value.trim();
        const found = users.find(u => u.email === email && u.password === password);
        if (!found) {
          authError.textContent = '이메일 또는 비밀번호가 맞지 않습니다';
          authError.classList.remove('hidden');
          return;
        }
        save(SESSION_KEY, found);
        state.user = found;
        render();
        requestCurrentLocation();
      });
      signupForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const users = load(USERS_KEY, defaultUsers);
        const name = document.getElementById('signupName').value.trim();
        const email = document.getElementById('signupEmail').value.trim();
        const password = document.getElementById('signupPassword').value.trim();
        if (!name || !email || !password) {
          authError.textContent = '모든 항목을 입력해주세요';
          authError.classList.remove('hidden');
          return;
        }
        if (users.some(u => u.email === email)) {
          authError.textContent = '이미 등록된 이메일입니다';
          authError.classList.remove('hidden');
          return;
        }
        const created = { id:'user-' + Date.now(), name, email, password, role:'USER' };
        const next = [...users, created];
        save(USERS_KEY, next);
        save(SESSION_KEY, created);
        state.user = created;
        render();
        requestCurrentLocation();
      });
    }

    function bindApp() {
      document.querySelectorAll('[data-nav]').forEach(btn => {
        btn.addEventListener('click', () => setState({ activeTab: btn.dataset.nav }));
      });
      document.querySelectorAll('[data-favorite]').forEach(btn => {
        btn.addEventListener('click', () => setState({ activeTab: 'route', latestDestination: btn.dataset.favorite }));
      });
      document.getElementById('logoutBtn').addEventListener('click', () => {
        localStorage.removeItem(SESSION_KEY);
        state.user = null;
        render();
      });

      if (state.activeTab === 'route') {
        const findBtn = document.getElementById('findRouteBtn');
        const locationBtn = document.getElementById('useLocationBtn');
        const resetBtn = document.getElementById('resetRouteBtn');
        if (findBtn) findBtn.addEventListener('click', handleRouteSearch);
        if (locationBtn) locationBtn.addEventListener('click', requestCurrentLocation);
        if (resetBtn) resetBtn.addEventListener('click', () => {
          setState({ routes: [], selectedRouteId: null, routeDestinationLabel: '', routeError: '', tripActive:false });
        });
        document.querySelectorAll('[data-route-id]').forEach(el => {
          el.addEventListener('click', () => setState({ selectedRouteId: Number(el.dataset.routeId) }));
        });
        const startTripBtn = document.getElementById('startTripBtn');
        if (startTripBtn) startTripBtn.addEventListener('click', startTrip);
      }

      if (state.activeTab === 'share') {
        const toggle = document.getElementById('shareToggle');
        if (toggle) toggle.addEventListener('change', () => {
          const next = { ...state.sharing, enabled: toggle.checked, lastSentAt: timeNow() };
          save(SHARE_KEY, next);
          setState({ sharing: next });
        });
      }

      if (state.activeTab === 'sos') {
        const sosBtn = document.getElementById('sosBtn');
        if (sosBtn) sosBtn.addEventListener('click', () => {
          setState({ sosSent: true });
          setTimeout(() => setState({ sosSent: false }), 2500);
        });
      }
    }

    function requestCurrentLocation() {
      if (!navigator.geolocation) {
        setState({ routeError: '현재 브라우저에서 위치 기능을 지원하지 않습니다' });
        return;
      }
      navigator.geolocation.getCurrentPosition(
        pos => {
          setState({
            currentLocation: {
              lat: pos.coords.latitude,
              lon: pos.coords.longitude,
              label: '현재 위치'
            },
            routeError: ''
          });
        },
        () => setState({ routeError: '현재 위치를 불러오지 못했습니다' }),
        { enableHighAccuracy:true, timeout:10000 }
      );
    }

    async function handleRouteSearch() {
      const startQuery = document.getElementById('startQuery')?.value.trim() || '';
      const destinationQuery = document.getElementById('destinationQuery')?.value.trim() || '';
      if (!destinationQuery) {
        setState({ routeError: '목적지를 입력해주세요' });
        return;
      }
      setState({ loadingRoutes: true, routeError: '' });
      try {
        let start = state.currentLocation;
        if (!start && startQuery) {
          start = await geocodePlace(startQuery);
          state.currentLocation = start;
        }
        if (!start) throw new Error('출발지를 먼저 설정해주세요');
        const destination = await geocodePlace(destinationQuery);
        const rawRoutes = await fetchRoute(start, destination);
        const routes = buildRouteVariants(rawRoutes);
        setState({
          routes,
          selectedRouteId: routes[0]?.id || null,
          latestDestination: destinationQuery,
          routeDestinationLabel: destination.label,
          loadingRoutes: false,
          routeError: ''
        });
      } catch (e) {
        setState({ loadingRoutes: false, routeError: e.message || '경로를 찾지 못했습니다' });
      }
    }

    function startTrip() {
      const route = selectedRoute();
      if (!route) return;
      const now = new Date();
      const endDate = new Date(now.getTime() + route.durationSeconds * 1000);
      const item = {
        id: 'h-' + Date.now(),
        date: now.getFullYear() + '.' + String(now.getMonth()+1).padStart(2,'0') + '.' + String(now.getDate()).padStart(2,'0'),
        start: now.toLocaleTimeString('ko-KR', { hour:'2-digit', minute:'2-digit' }),
        end: endDate.toLocaleTimeString('ko-KR', { hour:'2-digit', minute:'2-digit' }),
        route: route.name,
        status: '정상 귀가 예정',
        destination: state.routeDestinationLabel || state.latestDestination || '목적지'
      };
      const nextHistory = [item, ...state.history];
      const nextSharing = { enabled:true, lastSentAt: timeNow() };
      save(HISTORY_KEY, nextHistory);
      save(SHARE_KEY, nextSharing);
      setState({ history: nextHistory, sharing: nextSharing, tripActive:true, activeTab: 'share' });
    }

    function setupMap() {
      const el = document.getElementById('map');
      if (!el) return;
      if (state.map) {
        try { state.map.remove(); } catch (e) {}
        state.map = null;
      }
      const center = state.currentLocation ? [state.currentLocation.lat, state.currentLocation.lon] : [36.3504, 127.3845];
      const map = L.map('map').setView(center, 14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      if (state.currentLocation) {
        L.marker([state.currentLocation.lat, state.currentLocation.lon]).addTo(map).bindPopup('현재 위치');
      }
      if (state.routes.length) {
        let firstBounds = null;
        state.routes.forEach((route, idx) => {
          const color = state.selectedRouteId === route.id ? '#0f172a' : (idx === 0 ? '#334155' : '#94a3b8');
          const poly = L.polyline(route.geometry, { color, weight: state.selectedRouteId === route.id ? 6 : 4, opacity: 0.9 }).addTo(map);
          if (!firstBounds) firstBounds = poly.getBounds();
          else firstBounds.extend(poly.getBounds());
        });
        if (firstBounds) map.fitBounds(firstBounds, { padding: [20, 20] });
      }
      state.map = map;
    }

    function boot() {
      initStorage();
      state.user = load(SESSION_KEY, null);
      state.contacts = load(CONTACTS_KEY, defaultContacts);
      state.history = load(HISTORY_KEY, defaultHistory);
      state.sharing = load(SHARE_KEY, defaultShare);
      state.favorites = load(FAVORITES_KEY, defaultFavorites);
      render();
      if (state.user) requestCurrentLocation();
      setInterval(() => {
        if (state.user && state.sharing.enabled) {
          const next = { ...state.sharing, lastSentAt: timeNow() };
          save(SHARE_KEY, next);
          state.sharing = next;
          if (['share','guardian','dashboard'].includes(state.activeTab)) render();
        }
      }, 5000);
    }

    boot();
  </script>
</body>
</html>
