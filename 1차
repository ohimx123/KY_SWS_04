<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>밤길 안전 귀가 서비스 Pro</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f8fafc;
      color: #0f172a;
    }
    .app { min-height: 100vh; }
    .auth-wrap, .main-wrap {
      width: 100%;
      max-width: 1380px;
      margin: 0 auto;
      padding: 24px;
    }
    .auth-grid, .content-grid, .route-grid, .two-col, .three-col {
      display: grid;
      gap: 20px;
    }
    .auth-grid { grid-template-columns: 1.1fr 0.9fr; }
    .content-grid { grid-template-columns: 280px 1fr; min-height: 100vh; }
    .route-grid { grid-template-columns: 1.2fr 0.8fr; }
    .two-col { grid-template-columns: 1fr 1fr; }
    .three-col { grid-template-columns: 1fr 1fr 1fr; }
    .card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 24px;
      padding: 20px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
    }
    .hero {
      padding: 32px;
      border-radius: 28px;
      background: white;
      border: 1px solid #e2e8f0;
    }
    .title-row { display: flex; align-items: center; gap: 14px; }
    .logo {
      width: 58px;
      height: 58px;
      border-radius: 18px;
      background: #0f172a;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      font-size: 24px;
    }
    .muted { color: #64748b; }
    .small { font-size: 13px; }
    .tiny { font-size: 12px; }
    .grid-2, .grid-3, .grid-4 { display: grid; gap: 14px; }
    .grid-2 { grid-template-columns: repeat(2, 1fr); }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
    .grid-4 { grid-template-columns: repeat(4, 1fr); }
    .mini-card {
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 14px;
      background: #fff;
    }
    .highlight-card {
      border: 1px solid #cbd5e1;
      border-radius: 22px;
      padding: 16px;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }
    input, textarea, select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #cbd5e1;
      border-radius: 14px;
      font-size: 14px;
      background: white;
    }
    textarea { min-height: 110px; resize: vertical; }
    button {
      border: none;
      border-radius: 14px;
      padding: 12px 16px;
      background: #0f172a;
      color: white;
      cursor: pointer;
      font-size: 14px;
    }
    button.secondary {
      background: white;
      color: #0f172a;
      border: 1px solid #cbd5e1;
    }
    button.ghost {
      background: #f8fafc;
      color: #0f172a;
      border: 1px dashed #cbd5e1;
    }
    button:disabled { opacity: 0.6; cursor: not-allowed; }
    .tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; background: #f1f5f9; padding: 6px; border-radius: 16px; }
    .tabs button { background: transparent; color: #475569; }
    .tabs button.active { background: white; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .sidebar {
      background: white;
      border-right: 1px solid #e2e8f0;
      min-height: 100vh;
      padding: 20px;
    }
    .nav-btn {
      width: 100%;
      text-align: left;
      display: block;
      margin-bottom: 8px;
      background: white;
      color: #334155;
      border: 1px solid #e2e8f0;
    }
    .nav-btn.active { background: #0f172a; color: white; border-color: #0f172a; }
    .topbar {
      position: sticky;
      top: 0;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid #e2e8f0;
      padding: 18px 24px;
      z-index: 20;
    }
    .main-content { padding: 24px; }
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .stat-title { font-size: 13px; color: #64748b; }
    .stat-value { font-size: 28px; font-weight: bold; margin-top: 6px; }
    .badge {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      border: 1px solid #cbd5e1;
      background: #fff;
    }
    .badge.safe { background: #ecfdf5; color: #15803d; border-color: #bbf7d0; }
    .badge.good { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
    .badge.mid { background: #fffbeb; color: #b45309; border-color: #fde68a; }
    .badge.warn { background: #fef2f2; color: #b91c1c; border-color: #fecaca; }
    .alert {
      border: 1px solid #fcd34d;
      background: #fffbeb;
      color: #92400e;
      padding: 14px;
      border-radius: 16px;
      margin-bottom: 14px;
    }
    .success {
      border: 1px solid #86efac;
      background: #f0fdf4;
      color: #166534;
      padding: 14px;
      border-radius: 16px;
    }
    #map { height: 460px; border-radius: 24px; overflow: hidden; }
    .route-option {
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 14px;
      cursor: pointer;
      background: white;
    }
    .route-option.active { border-color: #0f172a; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08); }
    .progress {
      width: 100%;
      height: 10px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
    }
    .progress > div {
      height: 100%;
      background: #0f172a;
      width: 0;
    }
    .hidden { display: none !important; }
    .row { display: flex; gap: 10px; align-items: center; }
    .space-y > * + * { margin-top: 12px; }
    .switch-row { display: flex; justify-content: space-between; align-items: center; padding: 16px; border: 1px solid #e2e8f0; border-radius: 20px; }
    .history-item { border: 1px solid #e2e8f0; border-radius: 22px; padding: 16px; }
    .favorite-btn {
      text-align: left;
      border: 1px solid #e2e8f0;
      background: white;
      color: #0f172a;
      padding: 14px;
      border-radius: 18px;
      width: 100%;
    }
    .checklist-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 12px 14px;
    }
    .guardian-panel {
      border: 1px solid #cbd5e1;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      border-radius: 24px;
      padding: 18px;
    }
    .pill-row { display:flex; flex-wrap:wrap; gap:8px; }
    .status-strip {
      display:grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 14px;
    }
    .status-cell {
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      padding: 12px;
      background: #fff;
    }
    @media (max-width: 1100px) {
      .auth-grid, .content-grid, .route-grid, .two-col, .three-col { grid-template-columns: 1fr; }
      .stats, .grid-4, .grid-3, .grid-2, .status-strip { grid-template-columns: 1fr; }
      .sidebar { min-height: auto; border-right: none; border-bottom: 1px solid #e2e8f0; }
    }
  </style>
</head>
<body>
  <div id="app" class="app"></div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const USERS_KEY = 'night_safety_users_v2';
    const SESSION_KEY = 'night_safety_session_v2';
    const CONTACTS_KEY = 'night_safety_contacts_v2';
    const HISTORY_KEY = 'night_safety_history_v2';
    const SHARE_KEY = 'night_safety_sharing_v2';
    const FAVORITES_KEY = 'night_safety_favorites_v2';

    const defaultUsers = [{ id:'demo-user', name:'송우석', email:'demo@nightsafe.app', password:'1234', role:'PM' }];
    const defaultContacts = [
      { id:'c1', name:'홍길동', relation:'보호자', phone:'010-1234-5678' },
      { id:'c2', name:'김보호', relation:'지정 연락처', phone:'010-9876-5432' }
    ];
    const defaultHistory = [
      { id:'h1', date:'2026.03.18', start:'22:14', end:'22:31', route:'추천 안전 경로', status:'정상 귀가 완료', destination:'대전광역시 서구 둔산동' }
    ];
    const defaultShare = { enabled:true, lastSentAt: timeNow() };
    const defaultFavorites = [
      { id:'f1', label:'집', address:'대전광역시 유성구 봉명동' },
      { id:'f2', label:'학교', address:'충남대학교' },
      { id:'f3', label:'기숙사', address:'대전광역시 유성구 대학로' },
      { id:'f4', label:'알바', address:'대전광역시 서구 둔산동' }
    ];

    let state = {
      user: null,
      activeTab: 'dashboard',
      currentLocation: null,
      contacts: [],
      history: [],
      sharing: defaultShare,
      favorites: [],
      routes: [],
      selectedRouteId: null,
      latestDestination: '대전광역시청',
      routeDestinationLabel: '',
      loadingRoutes: false,
      routeError: '',
      sosSent: false,
      guardianMode: false,
      batteryLevel: 74,
      tripActive: false,
      map: null
    };

    function timeNow() {
      return new Date().toLocaleTimeString('ko-KR', { hour:'2-digit', minute:'2-digit' });
    }
    function save(key, value) { localStorage.setItem(key, JSON.stringify(value)); }
    function load(key, fallback) {
      try {
        const raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
      } catch { return fallback; }
    }
    function initStorage() {
      if (!localStorage.getItem(USERS_KEY)) save(USERS_KEY, defaultUsers);
      if (!localStorage.getItem(CONTACTS_KEY)) save(CONTACTS_KEY, defaultContacts);
      if (!localStorage.getItem(HISTORY_KEY)) save(HISTORY_KEY, defaultHistory);
      if (!localStorage.getItem(SHARE_KEY)) save(SHARE_KEY, defaultShare);
      if (!localStorage.getItem(FAVORITES_KEY)) save(FAVORITES_KEY, defaultFavorites);
    }
    function scoreLabel(score) {
      if (score >= 85) return ['매우 안전', 'safe'];
      if (score >= 70) return ['안전', 'good'];
      if (score >= 55) return ['보통', 'mid'];
      return ['주의', 'warn'];
    }
    function formatDistance(meters) {
      return meters < 1000 ? Math.round(meters) + 'm' : (meters / 1000).toFixed(1) + 'km';
    }
    function formatDuration(sec) {
      return Math.max(1, Math.round(sec / 60)) + '분';
    }
    function estimateSafetyScore(route, kind) {
      const distanceKm = route.distance / 1000;
      const durationMin = route.duration / 60;
      let base = 72;
      if (kind === 'balanced') base = 78;
      if (kind === 'short') base = 60;
      if (kind === 'safe') base = 88;
      const distancePenalty = Math.min(8, Math.round(distanceKm * 1.5));
      const durationPenalty = Math.min(6, Math.round(durationMin / 12));
      const score = Math.max(45, Math.min(96, base - distancePenalty - durationPenalty + (kind === 'safe' ? 4 : 0)));
      const reasons = [];
      if (kind === 'safe') reasons.push('큰 도로와 밝은 구간을 우선 고려');
      if (kind === 'balanced') reasons.push('안전성과 이동 시간의 균형을 반영');
      if (kind === 'short') reasons.push('최단 이동 시간 중심으로 계산');
      reasons.push('실시간 위치 기반 경로 계산 반영');
      reasons.push('야간 귀가 상황을 고려한 위험도 안내 제공');
      const factors = [
        { label:'가로등 구간', state: kind !== 'short' ? '우수' : '보통' },
        { label:'CCTV 인접성', state: kind === 'safe' ? '우수' : '양호' },
        { label:'편의시설 접근성', state: kind === 'safe' ? '양호' : '보통' },
        { label:'골목 비율', state: kind === 'short' ? '높음' : '낮음' }
      ];
      return { score, reasons, factors };
    }
    function decodePolyline(str, precision = 5) {
      let index = 0, lat = 0, lng = 0, coordinates = [], factor = Math.pow(10, precision);
      while (index < str.length) {
        let b, shift = 0, result = 0;
        do { b = str.charCodeAt(index++) - 63; result |= (b & 0x1f) << shift; shift += 5; } while (b >= 0x20);
        let dlat = result & 1 ? ~(result >> 1) : result >> 1; lat += dlat;
        shift = 0; result = 0;
        do { b = str.charCodeAt(index++) - 63; result |= (b & 0x1f) << shift; shift += 5; } while (b >= 0x20);
        let dlng = result & 1 ? ~(result >> 1) : result >> 1; lng += dlng;
        coordinates.push([lat / factor, lng / factor]);
      }
      return coordinates;
    }
    async function geocodePlace(query) {
      const url = 'https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + encodeURIComponent(query);
      const res = await fetch(url, { headers: { Accept:'application/json' } });
      if (!res.ok) throw new Error('주소 검색 실패');
      const data = await res.json();
      if (!data || !data.length) throw new Error('검색 결과 없음');
      return { lat:Number(data[0].lat), lon:Number(data[0].lon), label:data[0].display_name };
    }
    async function fetchRoute(start, end) {
      const url = `https://router.project-osrm.org/route/v1/driving/${start.lon},${start.lat};${end.lon},${end.lat}?overview=full&geometries=polyline&alternatives=true&steps=false`;
      const res = await fetch(url);
      if (!res.ok) throw new Error('경로 API 연결 실패');
      const data = await res.json();
      if (!data.routes || !data.routes.length) throw new Error('경로를 찾을 수 없음');
      return data.routes;
    }
    function buildRouteVariants(routes) {
      const sorted = [...routes].sort((a,b) => a.duration - b.duration);
      const shortest = sorted[0];
      const longest = sorted[sorted.length - 1];
      const middle = sorted[Math.floor(sorted.length / 2)] || shortest;
      const unique = [
        { raw: longest || shortest, kind:'safe', name:'추천 안전 경로' },
        { raw: middle || shortest, kind:'balanced', name:'균형 경로' },
        { raw: shortest, kind:'short', name:'최단 경로' }
      ].filter((item, idx, arr) => arr.findIndex(v => v.raw && v.raw.geometry === item.raw.geometry) === idx);
      return unique.map((item, idx) => {
        const safe = estimateSafetyScore(item.raw, item.kind);
        return {
          id: idx + 1,
          name: item.name,
          eta: formatDuration(item.raw.duration),
          distance: formatDistance(item.raw.distance),
          durationSeconds: item.raw.duration,
          distanceMeters: item.raw.distance,
          score: safe.score,
          reasons: safe.reasons,
          factors: safe.factors,
          geometry: decodePolyline(item.raw.geometry)
        };
      });
    }
    function selectedRoute() {
      return state.routes.find(r => r.id === state.selectedRouteId) || null;
    }
    function setState(next) {
      state = { ...state, ...next };
      render();
    }

    function render() {
      const app = document.getElementById('app');
      if (!state.user) {
        app.innerHTML = authHTML();
        bindAuth();
      } else {
        app.innerHTML = appHTML();
        bindApp();
        if (state.activeTab === 'route') setupMap();
      }
    }

    function authHTML() {
      return `
        <div class="auth-wrap">
          <div class="auth-grid">
            <div class="hero">
              <div class="title-row">
                <div class="logo">S</div>
                <div>
                  <div class="small muted">Night Safety Platform Pro</div>
                  <h1>밤길 안전 귀가 서비스</h1>
                </div>
              </div>
              <p style="line-height:1.8" class="muted">가장 빠른 길이 아니라 가장 안심되는 귀가를 돕는 서비스라는 방향으로 다시 설계한 HTML 버전입니다.</p>
              <div class="grid-2">
                <div class="mini-card"><strong>원터치 귀가 시작</strong><div class="small muted">집 학교 기숙사 즐겨찾기</div></div>
                <div class="mini-card"><strong>안전 근거 표시</strong><div class="small muted">경로와 함께 이유 설명</div></div>
                <div class="mini-card"><strong>보호자 대시보드</strong><div class="small muted">웹에서도 상태 확인</div></div>
                <div class="mini-card"><strong>긴급 대응</strong><div class="small muted">위치 공유 SOS 도착 알림</div></div>
              </div>
              <div class="highlight-card" style="margin-top:16px">
                <strong>데모 계정</strong><br>
                이메일 demo@nightsafe.app<br>
                비밀번호 1234
              </div>
            </div>
            <div class="card">
              <div class="tabs" id="authTabs">
                <button class="active" data-tab="login">로그인</button>
                <button data-tab="signup">회원가입</button>
              </div>
              <div id="authError" class="alert hidden" style="margin-top:14px"></div>
              <form id="loginForm" class="space-y" style="margin-top:18px">
                <div><label>이메일</label><input id="loginEmail" value="demo@nightsafe.app"></div>
                <div><label>비밀번호</label><input id="loginPassword" type="password" value="1234"></div>
                <button type="submit" style="width:100%">로그인</button>
              </form>
              <form id="signupForm" class="space-y hidden" style="margin-top:18px">
                <div><label>이름</label><input id="signupName"></div>
                <div><label>이메일</label><input id="signupEmail"></div>
                <div><label>비밀번호</label><input id="signupPassword" type="password"></div>
                <button type="submit" style="width:100%">회원가입 후 시작</button>
              </form>
            </div>
          </div>
        </div>`;
    }

    function appHTML() {
      return `
      <div class="content-grid">
        <aside class="sidebar">
          <div class="title-row">
            <div class="logo" style="width:48px;height:48px;font-size:20px">S</div>
            <div>
              <div class="small muted">Night Safety</div>
              <strong>안전 귀가 플랫폼</strong>
            </div>
          </div>
          <p class="small muted" style="line-height:1.7">길 추천이 아니라 귀가 과정 전체를 관리하는 안전 동행 시스템 구조입니다.</p>
          <div style="margin-top:18px">
            ${navButton('dashboard','대시보드')}
            ${navButton('route','안전 경로')}
            ${navButton('share','위치 공유')}
            ${navButton('guardian','보호자 화면')}
            ${navButton('sos','긴급 신고')}
            ${navButton('history','귀가 기록')}
            ${navButton('policy','보안 정책')}
          </div>
          <div class="card" style="margin-top:20px;padding:16px">
            <div class="small muted">현재 사용자</div>
            <div style="margin-top:10px"><strong>${state.user.name}</strong></div>
            <div class="small muted">${state.user.email}</div>
            <button id="logoutBtn" class="secondary" style="width:100%;margin-top:12px">로그아웃</button>
          </div>
        </aside>
        <div>
          <div class="topbar">
            <div class="row" style="justify-content:space-between">
              <div>
                <div class="small muted">Working HTML Demo</div>
                <strong>밤길 안전 귀가 서비스 Pro</strong>
              </div>
              <div class="row">
                <span class="badge">원터치 귀가</span>
                <span class="badge">보호자 연동</span>
                <span class="badge">경로 근거 표시</span>
              </div>
            </div>
          </div>
          <div class="main-content">
            ${state.activeTab === 'dashboard' ? dashboardHTML() : ''}
            ${state.activeTab === 'route' ? routeHTML() : ''}
            ${state.activeTab === 'share' ? shareHTML() : ''}
            ${state.activeTab === 'guardian' ? guardianHTML() : ''}
            ${state.activeTab === 'sos' ? sosHTML() : ''}
            ${state.activeTab === 'history' ? historyHTML() : ''}
            ${state.activeTab === 'policy' ? policyHTML() : ''}
          </div>
        </div>
      </div>`;
    }

    function navButton(key, label) {
      return `<button class="nav-btn ${state.activeTab === key ? 'active' : ''}" data-nav="${key}">${label}</button>`;
    }

    function dashboardHTML() {
      const route = selectedRoute();
      return `
      <div class="space-y">
        <div class="stats">
          ${statCard('현재 안전도', route ? route.score + '점' : '-', '추천 경로 기준 점수')}
          ${statCard('예상 귀가 시간', route ? route.eta : '-', '실제 경로 계산 기반')}
          ${statCard('위치 공유 상태', state.sharing.enabled ? 'ON' : 'OFF', '지정 연락처와 연동')}
          ${statCard('귀가 상태', state.tripActive ? '이동 중' : '대기 중', '원터치 귀가 시작 가능')}
        </div>

